From 759fd377e15fbcd26480eed7e45fe3ad32abe927 Mon Sep 17 00:00:00 2001
From: Yaroslav Hryhorenko <yarik13371337@gmail.com>
Date: Tue, 24 Nov 2026 19:40:10 +0200
Subject: [PATCH] Build on QNX 8.0: guard the Linux-only parts

sched_setattr/getattr return ENOSYS (no SCHED_DEADLINE), RLIMIT_RTPRIO and
/proc/loadavg are skipped, SIGEV_THREAD_ID maps to SIGEV_SIGNAL_THREAD, gettid
comes from the compat layer, and pi_stress binds each thread to its CPU itself
because QNX has no run-mask thread attribute.
---
 src/cyclictest/cyclictest.c | 20 +++++++++++++++++++-
 src/lib/rt-sched.c          | 17 +++++++++++++++++
 src/lib/rt-utils.c          |  2 ++
 src/pi_tests/pi_stress.c    | 31 +++++++++++++++++++++++++++++++
 4 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/src/cyclictest/cyclictest.c b/src/cyclictest/cyclictest.c
index 58b56bc..fb86a66 100644
--- a/src/cyclictest/cyclictest.c
+++ b/src/cyclictest/cyclictest.c
@@ -57,7 +57,9 @@
 #define CLOCK_AUX 16
 #endif
 
+#ifndef __QNX__
 #define sigev_notify_thread_id _sigev_un._tid
+#endif
 
 #ifdef __UCLIBC__
 #define MAKE_PROCESS_CPUCLOCK(pid, clock) \
@@ -475,6 +477,11 @@ static int raise_soft_prio(int policy, const struct sched_param *param)
 	int prio;
 	struct rlimit rlim;
 
+#ifdef __QNX__
+	/* no RLIMIT_RTPRIO: QNX gates real-time priorities with abilities, not rlimits */
+	(void)err; (void)policy_max; (void)soft_max; (void)hard_max; (void)prio; (void)rlim;
+	return -1;
+#else
 	prio = param->sched_priority;
 
 	policy_max = sched_get_priority_max(policy);
@@ -509,6 +516,7 @@ static int raise_soft_prio(int policy, const struct sched_param *param)
 	}
 
 	return err;
+#endif /* __QNX__ */
 }
 
 /*
@@ -682,7 +690,9 @@ static void *timerthread(void *param)
 	if (par->mode == MODE_CYCLIC) {
 		sigev.sigev_notify = SIGEV_THREAD_ID | SIGEV_SIGNAL;
 		sigev.sigev_signo = par->signal;
+#ifndef __QNX__
 		sigev.sigev_notify_thread_id = stat->tid;
+#endif
 		if (timer_create(par->clock, &sigev, &timer))
 			fatal("timerthread%d: failed to create timer for clock %d, errno: %d\n",
 			      par->cpu, par->clock, errno);
@@ -2271,7 +2281,10 @@ int main(int argc, char **argv)
 
 	while (!shutdown) {
 		char lavg[256];
-		int fd, len, allstopped = 0;
+		#ifndef __QNX__
+		int fd, len;
+#endif
+		int allstopped = 0;
 		static char *policystr = NULL;
 		static char *slash = NULL;
 		static char *policystr2;
@@ -2287,10 +2300,15 @@ int main(int argc, char **argv)
 				slash = policystr2 = "";
 		}
 		if (!verbose && !quiet) {
+#ifdef __QNX__
+			/* no /proc/loadavg on QNX */
+			strcpy(lavg, "n/a");
+#else
 			fd = open("/proc/loadavg", O_RDONLY, 0666);
 			len = read(fd, &lavg, 255);
 			close(fd);
 			lavg[len-1] = 0x0;
+#endif
 			printf("policy: %s%s%s: loadavg: %s          \n\n",
 			       policystr, slash, policystr2, lavg);
 		}
diff --git a/src/lib/rt-sched.c b/src/lib/rt-sched.c
index 8023bc7..37b488e 100644
--- a/src/lib/rt-sched.c
+++ b/src/lib/rt-sched.c
@@ -14,6 +14,22 @@
 
 #include "rt-sched.h"
 
+#ifdef __QNX__
+/* QNX has no SCHED_DEADLINE: report ENOSYS the way an old Linux kernel does. */
+#include <errno.h>
+int sched_setattr(pid_t pid, const struct sched_attr *attr, unsigned int flags)
+{
+	errno = ENOSYS;
+	return -1;
+}
+
+int sched_getattr(pid_t pid, struct sched_attr *attr, unsigned int size,
+		  unsigned int flags)
+{
+	errno = ENOSYS;
+	return -1;
+}
+#else
 int sched_setattr(pid_t pid,
 		  const struct sched_attr *attr,
 		  unsigned int flags)
@@ -28,3 +44,4 @@ int sched_getattr(pid_t pid,
 {
 	return syscall(__NR_sched_getattr, pid, attr, size, flags);
 }
+#endif /* __QNX__ */
diff --git a/src/lib/rt-utils.c b/src/lib/rt-utils.c
index aa70c78..6f04d91 100644
--- a/src/lib/rt-utils.c
+++ b/src/lib/rt-utils.c
@@ -288,10 +288,12 @@ uint32_t string_to_policy(const char *str)
 	return 0;
 }
 
+#ifndef __QNX__
 pid_t gettid(void)
 {
 	return syscall(SYS_gettid);
 }
+#endif /* __QNX__: gettid() comes from qnx-compat */
 
 /*
  * parse an input value as a base10 value followed by an optional
diff --git a/src/pi_tests/pi_stress.c b/src/pi_tests/pi_stress.c
index 500b10d..609fcdb 100644
--- a/src/pi_tests/pi_stress.c
+++ b/src/pi_tests/pi_stress.c
@@ -241,12 +241,14 @@ setup_thread_attr(pthread_attr_t *attr, struct sched_attr *sa,
 		     status);
 		return FAILURE;
 	}
+#ifndef __QNX__
 	status = pthread_attr_setaffinity_np(attr, sizeof(cpu_set_t), mask);
 	if (status) {
 		pi_error("%s: setting affinity attribute: 0x%x\n", __func__,
 			 status);
 		return FAILURE;
 	}
+#endif /* QNX has no thread attribute for the run mask: threads bind themselves, see bind_to_group_cpu() */
 
 	/*
 	 * The pthread API does not yet support SCHED_DEADLINE, defer the
@@ -388,6 +390,20 @@ int pending_interrupt(void)
  *   1. report progress
  *   2. check for deadlocks
  */
+#ifdef __QNX__
+/* First thing each group thread does: run only on the CPU of its group. */
+static int bind_to_group_cpu(long cpu)
+{
+	cpu_set_t mask;
+
+	CPU_ZERO(&mask);
+	CPU_SET(cpu, &mask);
+	return sched_setaffinity(0, sizeof(cpu_set_t), &mask);
+}
+#else
+#define bind_to_group_cpu(cpu) 0
+#endif
+
 void *reporter(void *arg)
 {
 	int status;
@@ -494,6 +510,11 @@ void *low_priority(void *arg)
 	pthread_mutex_t *loop_mtx = &p->loop_mtx;
 	int *loop = &p->loop;
 
+	if (bind_to_group_cpu(p->cpu)) {
+		pi_error("low_priority[%d]: binding to cpu %ld failed\n", p->id, p->cpu);
+		return NULL;
+	}
+
 	allow_sigterm();
 
 	if (verify_cpu(p->cpu) != SUCCESS) {
@@ -630,6 +651,11 @@ void *med_priority(void *arg)
 	pthread_mutex_t *loop_mtx = &p->loop_mtx;
 	int *loop = &p->loop;
 
+	if (bind_to_group_cpu(p->cpu)) {
+		pi_error("med_priority[%d]: binding to cpu %ld failed\n", p->id, p->cpu);
+		return NULL;
+	}
+
 	allow_sigterm();
 
 	if (verify_cpu(p->cpu) != SUCCESS) {
@@ -757,6 +783,11 @@ void *high_priority(void *arg)
 		}
 	}
 
+	if (bind_to_group_cpu(p->cpu)) {
+		pi_error("high_priority[%d]: binding to cpu %ld failed\n", p->id, p->cpu);
+		return NULL;
+	}
+
 	allow_sigterm();
 	if (verify_cpu(p->cpu) != SUCCESS) {
 		pi_error("high_priority[%d]: not bound to %ld\n", p->id, p->cpu);
-- 
