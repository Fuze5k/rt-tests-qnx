@@ -255,6 +257,7 @@ static char shm_name[SHM_BUF_SIZE];
  *
  * Documentation/power/pm_qos_interface.txt
  */
+#ifndef __QNX__
 static void set_latency_target(void)
 {
 	struct stat s;
@@ -298,6 +301,7 @@ static void set_latency_target(void)
 	}
 	printf("# /dev/cpu_dma_latency set to %dus\n", latency_target_value);
 }
+#endif
 
 #ifdef HAVE_LIBCPUPOWER_SUPPORT
 static unsigned int **saved_cpu_idle_disable_state;
@@ -475,6 +479,11 @@ static int raise_soft_prio(int policy, const struct sched_param *param)
 	int prio;
 	struct rlimit rlim;
 
+#ifdef __QNX__
+	/* no RLIMIT_RTPRIO: QNX gates real-time priorities with abilities, not rlimits */
+	(void)err; (void)policy_max; (void)soft_max; (void)hard_max; (void)prio; (void)rlim;
+	return -1;
+#else
 	prio = param->sched_priority;
 
 	policy_max = sched_get_priority_max(policy);
@@ -509,6 +518,7 @@ static int raise_soft_prio(int policy, const struct sched_param *param)
 	}
 
 	return err;
+#endif /* __QNX__ */
 }
 
 /*
@@ -519,6 +529,14 @@ static int raise_soft_prio(int policy, const struct sched_param *param)
 static int setscheduler(pid_t pid, int policy, const struct sched_param *param)
 {
 	int err = 0;
+#ifdef __QNX__
+	/* QNX has no priority 0: SCHED_OTHER threads run at the default priority 10 */
+	struct sched_param qnx_param = *param;
+
+	if (policy == SCHED_OTHER && qnx_param.sched_priority == 0)
+		qnx_param.sched_priority = 10;
+	param = &qnx_param;
+#endif
 
 try_again:
 	err = sched_setscheduler(pid, policy, param);
@@ -682,7 +700,9 @@ static void *timerthread(void *param)
 	if (par->mode == MODE_CYCLIC) {
 		sigev.sigev_notify = SIGEV_THREAD_ID | SIGEV_SIGNAL;
 		sigev.sigev_signo = par->signal;
+#ifndef __QNX__
 		sigev.sigev_notify_thread_id = stat->tid;
+#endif
 		if (timer_create(par->clock, &sigev, &timer))
 			fatal("timerthread%d: failed to create timer for clock %d, errno: %d\n",
 			      par->cpu, par->clock, errno);
@@ -1475,6 +1495,7 @@ static void process_options(int argc, char *argv[], int max_cpus)
 	}
 }
 
+#ifndef __QNX__
 static int check_timer(void)
 {
 	struct timespec ts;
@@ -1484,6 +1505,7 @@ static int check_timer(void)
 
 	return (ts.tv_sec != 0 || ts.tv_nsec != 1);
 }
+#endif
 
 static void sighand(int sig)
 {
@@ -1996,8 +2018,10 @@ int main(int argc, char **argv)
 			goto out;
 		}
 
+#ifndef __QNX__
 	/* use the /dev/cpu_dma_latency trick if it's there */
 	set_latency_target();
+#endif
 
 	if (deepest_idle_state >= -1) {
 		if (!have_libcpupower_support()) {
@@ -2022,8 +2046,14 @@ int main(int argc, char **argv)
 	if (tracelimit && trace_marker)
 		enable_trace_mark();
 
+#ifdef __QNX__
+	/* QNX has no hrtimer switch; the kernel clock period sets the timer granularity */
+	if (!quiet)
+		printf("# QNX clock period: %ld us\n", qnx_clock_period_ns() / 1000);
+#else
 	if (check_timer())
 		warn("High resolution timers not available\n");
+#endif
 
 	if (check_clock_resolution) {
 		uint64_t diff;
@@ -2271,7 +2301,10 @@ int main(int argc, char **argv)
 
 	while (!shutdown) {
 		char lavg[256];
-		int fd, len, allstopped = 0;
+		#ifndef __QNX__
+		int fd, len;
+#endif
+		int allstopped = 0;
 		static char *policystr = NULL;
 		static char *slash = NULL;
 		static char *policystr2;
@@ -2287,10 +2320,15 @@ int main(int argc, char **argv)
 				slash = policystr2 = "";
 		}
 		if (!verbose && !quiet) {
+#ifdef __QNX__
+			/* no /proc/loadavg on QNX */
+			strcpy(lavg, "n/a");
+#else
 			fd = open("/proc/loadavg", O_RDONLY, 0666);
 			len = read(fd, &lavg, 255);
 			close(fd);
 			lavg[len-1] = 0x0;
+#endif
 			printf("policy: %s%s%s: loadavg: %s          \n\n",
 			       policystr, slash, policystr2, lavg);
 		}
diff --git a/src/include/rt-get_cpu.h b/src/include/rt-get_cpu.h
